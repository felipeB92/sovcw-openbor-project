
name			TerryP01 #THROWNED
type			none
speed 12
candamage			enemy obstacle
alpha 1
nolife			1
lifespan		4
remove			1
gfxshadow		0 0
flash			Forte
antigravity 100
animationscript		data/scripts/Felipe.c

anim idle
	loop	1
	offset	42 140
		delay  5
        Followcond 1
        followanim 1
	frame	data/chars/players/Terry/P2/p00.gif
        @cmd dasher 1 0 0
	frame	data/chars/players/Terry/P2/p01.gif
	frame	data/chars/players/Terry/P2/p02.gif


anim Follow1
	loop	1
	offset	42 140
		delay  1
	frame	data/chars/players/Terry/P2/p00.gif
	@cmd killentity getlocalvar("self")
	frame	data/chars/players/Terry/P2/p00.gif


