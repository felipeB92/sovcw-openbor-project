name	PArticle
health	70
mp 30
mprate 1
#secret 1
Falldie 2
Grabdistance 18
riseinv				0.4 1
speed	12
type	Enemy
gfxshadow	1
candamage			Player npc obstacle
JUMPHEIGHT 4
hostile Player NPC
antigrab 2
atchain   1 1 2 3 4 5
weapons P1_Knife P1_Sword P1_pipe P1_Kunai
icon	data/chars/Enemys/Particle/icon.gif 1
#diesound data/Sounds/Die5.wav
running	20	3	2	1	1
onblockwscript	data/scripts/bounceF.c
#animationscript 	data/scripts/ani0020.h
animationscript		data/scripts/drago.c
ondrawscript 		data/scripts/Enemy_ondrawscript.c



Load LAser02
Load EX02
#Load P1_Pipe
#Load P1_Kunai
#Load P1_Sword

remap data/chars/Enemys/Particle/idle00.gif data/chars/Enemys/Particle/MAp01.gif
