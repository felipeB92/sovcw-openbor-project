remap data/chars/Enemys/Particle/idle00.gif data/chars/Enemys/Particle/MAp04.gif






anim idle
	loop	1
	delay	12
	offset	146 194
	bbox	121 103 44 93
	frame   data/chars/Enemys/Particle/idle00.gif
	@cmd	depost 0
	@cmd	throw 15 0.7 0.7 1 0 -1
	@cmd	clearL
	frame   data/chars/Enemys/Particle/idle00.gif



