anim Freespecial
	loop	0
	offset	253 207
        Range   0 500
        Rangez  0  300
        energycost 50 1
        MpOnly 1
		delay  15
	frame   data/chars/enemys/zh/Boddy.gif
	@cmd  spawn01  "Super2"  0  0  0
	frame   data/chars/enemys/zh/Boddy.gif
