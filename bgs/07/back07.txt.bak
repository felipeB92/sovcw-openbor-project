	frame   data/chars/enemys/zh/Boddy.gif
		offset  253  170
	frame   data/chars/enemys/zh/Boddy.gif
		offset  253  180
	frame   data/chars/enemys/zh/Boddy.gif
		offset  253  190
	frame   data/chars/enemys/zh/Boddy.gif
		offset  253  200
	frame   data/chars/enemys/zh/Boddy.gif
	offset	253 207
